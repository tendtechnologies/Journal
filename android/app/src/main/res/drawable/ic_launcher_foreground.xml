<?xml version="1.0" encoding="utf-8"?>
<!--
  The same book-and-ribbon mark as the web app's icon, remapped from its 512
  grid onto the 108dp adaptive-icon viewport and scaled to sit inside the 66dp
  safe circle, so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Book: stroked, round joins, top-right corner radiused. -->
    <path
        android:pathData="M28.5,27 L74,27 A5.6,5.6 0 0 1 79.5,32.6 L79.5,81 L28.5,81 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Bookmark ribbon: solid, right of centre, tucked under the top edge. -->
    <path
        android:pathData="M56.6,24.5 L68.6,24.5 L68.6,54.4 L62.6,47.2 L56.6,54.4 Z"
        android:fillColor="#FFFFFF" />
</vector>
