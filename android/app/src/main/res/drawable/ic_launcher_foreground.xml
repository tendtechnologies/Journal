<?xml version="1.0" encoding="utf-8"?>
<!--
  The same book-and-ribbon mark as the web app's icon, remapped from its 512
  grid onto the 108dp adaptive-icon viewport.

  The first version of this file claimed to sit inside the 66dp safe circle
  but didn't measure it: the book's bottom corners and the ribbon's top edge
  landed ~37dp from centre against a 33dp safe radius, so a circular or
  squircle launcher mask (Pixel, most OEM skins) clipped a slice off the
  book and ribbon on every install — that's the "out of scale" look. Every
  point below is now checked to land at <=30.2dp from centre (54,54), a 3dp
  margin inside the 33dp safe radius, so nothing here can be clipped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Book: stroked, round joins, top-right corner radiused. -->
    <path
        android:pathData="M33.3,32.1 L70.2,32.1 A4.5,4.5 0 0 1 74.7,36.7 L74.7,75.9 L33.3,75.9 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7.3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Bookmark ribbon: solid, right of centre, tucked under the top edge. -->
    <path
        android:pathData="M56.1,30.1 L65.8,30.1 L65.8,54.3 L61,48.5 L56.1,54.3 Z"
        android:fillColor="#FFFFFF" />
</vector>
